{
  "name": "db-sync-tool",
  "version": "1.0.2",
  "description": "CLI for backing up and restoring PostgreSQL/MySQL databases with .env support, compression, and retention",
  "type": "module",
  "bin": {
    "dbsync": "./bin/dbsync.js"
  },
  "main": "./src/index.js",
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.0",
    "dotenv": "^17.0.0",
    "mysql2": "^3.11.0",
    "ora": "^9.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "eslint": "^10.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "keywords": [
    "postgresql",
    "mysql",
    "backup",
    "restore",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Habityzer/dbsync.git"
  },
  "bugs": {
    "url": "https://github.com/Habityzer/dbsync/issues"
  }
}
